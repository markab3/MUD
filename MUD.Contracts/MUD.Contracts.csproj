<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Core.Api" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- The .proto files live in the repository-level contracts directory (D23); generated code goes to obj. -->
    <Protobuf Include="..\contracts\mud\*.proto" ProtoRoot="..\contracts" GrpcServices="Both" />
  </ItemGroup>

</Project>
