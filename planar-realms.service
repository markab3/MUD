# Planar Realms MUD server - systemd USER unit. No secrets belong in this file.
# Install:  mkdir -p ~/.config/systemd/user && cp planar-realms.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now planar-realms
# See specs/DEPLOYMENT.md.
[Unit]
Description=Planar Realms MUD Server
After=network-online.target mongod.service
Wants=network-online.target
# D70: restart core at most 3 times within 5 minutes, then stay failed. This is what stops a required module that
# never becomes Ready (core exits with an error, D21) from looping forever.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# Release layout is managed by scripts/deploy.sh: current -> releases/<id>
WorkingDirectory=%h/.local/share/mud/current
ExecStart=%h/.local/share/mud/current/MUD.Main

# Defaults for bind address and port; override in ~/.config/mud/server.env.
Environment=MUD_BIND_ADDRESS=0.0.0.0
Environment=MUD_PORT=7680
# Required: provides MUD_MONGO_URI (created by the maintainer's install script, mode 600).
EnvironmentFile=%h/.config/mud/mongo.env
# Optional overrides (MUD_BIND_ADDRESS, MUD_PORT); the leading '-' tolerates a missing file.
EnvironmentFile=-%h/.config/mud/server.env

# Stopping core signals every module child too, so none is left behind. Time for the graceful module stop plus the persistence drain.
KillMode=control-group
TimeoutStopSec=60
# Modules are children of core and need to find dotnet; the supervisor passes DOTNET_ROOT on to them (it is never inherited blindly).
Environment=DOTNET_ROOT=/usr/share/dotnet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
