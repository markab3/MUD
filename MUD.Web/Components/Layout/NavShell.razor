@inject IAuthorizationService Authz
@* Same items and visibility as the Razor layout. Phone: bottom tab bar + a "More" sheet; tablet/desktop: left rail. Breakpoints are CSS. *@
<AuthorizeView>
    <Authorized>
        <nav class="mud-nav@(_open ? " mud-open" : "")" aria-label="Main">
            <ul>
                @if (_creator)
                {
                    <li><NavLink href="@WebRoutes.Map">Map</NavLink></li>
                    <li><NavLink href="@WebRoutes.Creator" Match="NavLinkMatch.All">Creator</NavLink></li>
                    <li><NavLink href="@WebRoutes.Players">Players</NavLink></li>
                    <li class="mud-nav-extra"><NavLink href="@WebRoutes.Modules">Modules</NavLink></li>
                    <li class="mud-nav-extra"><NavLink href="@WebRoutes.Terrain">Terrain</NavLink></li>
                }
                <li class="@(_creator ? "mud-nav-extra" : null)"><NavLink href="@WebRoutes.Character">Character</NavLink></li>
                <li class="@(_creator ? "mud-nav-extra" : null)"><NavLink href="@WebRoutes.Password">Change password</NavLink></li>
                <li class="mud-nav-extra mud-nav-logout">
                    <form method="post" action="@WebRoutes.Logout">
                        <input type="hidden" name="@Tokens.FormFieldName" value="@Tokens.RequestToken" />
                        <button type="submit" class="mud-btn">Log out</button>
                    </form>
                </li>
                <li class="mud-nav-more"><button type="button" class="mud-btn" aria-expanded="@_open.ToString().ToLowerInvariant()" @onclick="Toggle">More</button></li>
            </ul>
        </nav>
        @if (_open) { <div class="mud-backdrop" @onclick="Toggle"></div> }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [CascadingParameter] private AntiforgeryTokens Tokens { get; set; } = new(string.Empty, string.Empty);
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private bool _creator;
    private bool _open;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState == null) { return; }
        var user = (await AuthState).User;
        _creator = user.Identity?.IsAuthenticated == true && (await Authz.AuthorizeAsync(user, WebPolicies.CreatorOrAdmin)).Succeeded;
    }

    protected override void OnInitialized() => Navigation.LocationChanged += (_, _) => { _open = false; InvokeAsync(StateHasChanged); };

    private void Toggle() => _open = !_open;
}
