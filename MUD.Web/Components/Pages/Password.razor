@page "/account/password"
@attribute [Authorize]
@inject IAdminClient Core
@inject LoginThrottle Throttle
<PageTitle>Change password - Planar Realms</PageTitle>
<h1>Change password</h1>
@if (_presenter.Succeeded)
{
    <p role="status" class="mud-ok">@Messages.PasswordChanged</p>
}
@if (_presenter.Error != null)
{
    <p role="alert" class="mud-error">@_presenter.Error</p>
}
<form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <div class="mud-field"><label for="pw-current">Current password</label>
        <input id="pw-current" type="password" @bind="_current" @bind:event="onchange" autocomplete="current-password" required /></div>
    <div class="mud-field"><label for="pw-new">New password</label>
        <input id="pw-new" type="password" @bind="_new" @bind:event="onchange" autocomplete="new-password" maxlength="64" required /></div>
    <div class="mud-field"><label for="pw-confirm">Confirm new password</label>
        <input id="pw-confirm" type="password" @bind="_confirm" @bind:event="onchange" autocomplete="new-password" maxlength="64" required /></div>
    <div class="mud-actions">
        <button type="submit" class="mud-btn mud-btn-primary mud-save" disabled="@_busy">Change password</button>
    </div>
</form>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private PasswordPresenter _presenter = default!;
    private string? _current, _new, _confirm;
    private bool _busy;

    protected override void OnInitialized() => _presenter = new PasswordPresenter(Core, Throttle);

    private async Task SubmitAsync()
    {
        if (_busy) { return; }
        _busy = true;
        try
        {
            var user = (await AuthState).User;
            var token = user.FindFirstValue(SessionAuthentication.TokenClaim) ?? string.Empty;
            var ip = user.FindFirstValue(SessionAuthentication.RemoteClaim) ?? "unknown";
            await _presenter.ChangeAsync(token, ip, _current, _new, _confirm);
        }
        finally
        {
            // Never rendered back and never kept: cleared after every submit.
            _current = _new = _confirm = null;
            _busy = false;
        }
    }
}
