@page "/creator/areas"
@attribute [Authorize(Policy = WebPolicies.CreatorOrAdmin)]
@inject IAdminClient Core
@inject NoticeService Notices
<PageTitle>Areas - Planar Realms</PageTitle>
<h1>Areas</h1>
@if (_presenter == null)
{
    <p class="mud-loading" aria-busy="true">Loading...</p>
}
else
{
    var p = _presenter;
    <p class="mud-hint">@AreaListPresenter.Help</p>
    @if (p.Notice != null) { <p role="status" class="mud-ok">@p.Notice</p> }
    @if (p.Error != null) { <p role="alert" class="mud-error">@p.Error</p> }
    @* No Cancel button: pressing New area (or the row's Edit) again while the form is open closes it. *@
    <button type="button" class="mud-btn mud-btn-primary mud-btn-block" id="ar-new" aria-expanded="@(p.IsNew ? "true" : "false")" disabled="@_busy" @onclick="ToggleNew">New area</button>
    @if (p.FormOpen)
    {
        <section class="mud-section" aria-labelledby="ar-form-h">
            <h2 id="ar-form-h">@(p.IsNew ? "New area" : "Edit area")</h2>
            @if (p.Problems.Count > 0)
            {
                <ul role="alert" class="mud-error">
                    @foreach (var m in p.Problems) { <li>@m</li> }
                </ul>
            }
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault novalidate>
                <div class="mud-field"><label for="ar-id">Prefix</label>
                    @if (p.IsNew)
                    {
                        <input id="ar-id" value="@p.FormId" @onchange="e => p.FormId = e.Value?.ToString()" maxlength="128" required autocomplete="off" autocapitalize="none" />
                        <span class="mud-hint">(lowercase letters, digits and '_'; fixed once created)</span>
                    }
                    else
                    {
                        <input id="ar-id" value="@p.EditingId" readonly="readonly" maxlength="128" />
                        <span class="mud-hint">(fixed: renaming an area means moving its rooms)</span>
                    }</div>
                <div class="mud-field"><label for="ar-name">Name</label>
                    <input id="ar-name" value="@p.FormName" @onchange="e => p.FormName = e.Value?.ToString()" maxlength="@MUD.Data.AreaRules.MaxName" required autocomplete="off" /></div>
                <div class="mud-field"><label for="ar-desc">Short description</label>
                    <input id="ar-desc" value="@p.FormDescription" @onchange="e => p.FormDescription = e.Value?.ToString()" maxlength="@MUD.Data.AreaRules.MaxDescription" autocomplete="off" />
                    <span class="mud-hint">(optional, at most @MUD.Data.AreaRules.MaxDescription characters)</span></div>
                <button type="submit" class="mud-btn mud-btn-primary mud-btn-block mud-save" id="ar-save" disabled="@_busy">Save</button>
            </form>
        </section>
    }
    @if (_confirm != null)
    {
        <ConfirmDialog Label="Confirm delete" Text="@(AreaListPresenter.DeleteConfirm + " (" + _confirm.Id + ")")" ConfirmText="Delete"
                       Busy="_busy" OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />
    }

    @* Wide screens: a table. Under 600px: the same rows as stacked cards (mobile.css switches them; no round trip). *@
    <div class="mud-table-wrap">
        <table class="mud-table">
            <thead><tr><th>Prefix</th><th>Name</th><th>Description</th><th>Rooms</th><th>Contains</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var a in p.Areas)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@a.Name</td>
                    <td>@a.Description</td>
                    <td>@a.RoomCount</td>
                    <td>@Links(a)</td>
                    <td>
                        <div class="mud-actions">
                            <button type="button" class="mud-btn" data-mutating disabled="@_busy" @onclick="() => Edit(a.Id)">Edit</button>
                            <button type="button" class="mud-btn mud-btn-danger" data-mutating disabled="@_busy" @onclick="() => Ask(a)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            @if (p.Areas.Count == 0)
            {
                <tr><td colspan="6">There are no areas.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <ul class="mud-cardlist mud-cards">
        @foreach (var a in p.Areas)
        {
            <li>
                <strong class="mud-card-title">@a.Name</strong>
                <dl class="mud-facts">
                    <dt>Prefix</dt><dd>@a.Id</dd>
                    <dt>Description</dt><dd>@a.Description</dd>
                    <dt>Rooms</dt><dd>@a.RoomCount</dd>
                    <dt>Contains</dt><dd>@Links(a)</dd>
                </dl>
                <div class="mud-actions">
                    <button type="button" class="mud-btn" data-mutating disabled="@_busy" @onclick="() => Edit(a.Id)">Edit</button>
                    <button type="button" class="mud-btn mud-btn-danger" data-mutating disabled="@_busy" @onclick="() => Ask(a)">Delete</button>
                </div>
            </li>
        }
        @if (p.Areas.Count == 0)
        {
            <li>There are no areas.</li>
        }
    </ul>
}

@code {
    // What the area holds today, as links to the pages that list it.
    private RenderFragment Links(Contracts.AreaRecord a) => @<div class="mud-arealinks">
        <a class="mud-btn" href="@AreaListPresenter.RoomsUrl(a.Id)">@Count(a.RoomCount, "room")</a>
        <a class="mud-btn" href="@AreaListPresenter.TerrainTypesUrl(a.Id)">@Count(_presenter?.TerrainTypesIn(a.Id), "terrain type")</a>
        <a class="mud-btn" href="@AreaListPresenter.ItemTemplatesUrl(a.Id)">@Count(_presenter?.ItemTemplatesIn(a.Id), "item template")</a>
        <a class="mud-btn" href="@AreaListPresenter.NpcTemplatesUrl(a.Id)">@Count(_presenter?.NpcTemplatesIn(a.Id), "NPC template")</a>
    </div>;

    private static string Count(int? n, string noun) => n == null ? "? " + noun + "s" : n + " " + noun + (n == 1 ? "" : "s");

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private AreaListPresenter? _presenter;
    private Contracts.AreaRecord? _confirm;
    private string _token = string.Empty;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _token = (await AuthState).User.FindFirstValue(SessionAuthentication.TokenClaim) ?? string.Empty;
        var presenter = new AreaListPresenter(Core, _token);
        await presenter.LoadAsync();
        presenter.Notice = Notices.Take();
        _presenter = presenter;
    }

    // The same button again closes the form it opened (there is no Cancel button).
    private void Edit(string id)
    {
        if (_presenter == null) { return; }
        if (_presenter.FormOpen && !_presenter.IsNew && _presenter.EditingId == id) { _presenter.CancelForm(); } else { _presenter.BeginEdit(id); }
    }

    private void ToggleNew()
    {
        if (_presenter == null) { return; }
        if (_presenter.IsNew) { _presenter.CancelForm(); } else { _presenter.BeginNew(); }
    }

    private void Ask(Contracts.AreaRecord area) => _confirm = area;

    private void CancelDelete() => _confirm = null;

    // One write at a time: a double tap cannot send two requests.
    private async Task SaveAsync()
    {
        if (_busy || _presenter == null) { return; }
        _busy = true;
        try
        {
            var p = _presenter;
            if (await p.SaveAsync() == AreaOutcome.Ok)
            {
                var notice = p.Notice;
                await p.LoadAsync();
                p.Notice = notice;
            }
        }
        finally { _busy = false; }
    }

    private async Task ConfirmDeleteAsync()
    {
        var area = _confirm;
        if (_busy || area == null || _presenter == null) { return; }
        _busy = true;
        _confirm = null;
        try
        {
            var p = _presenter;
            if (await p.DeleteAsync(area.Id) == AreaOutcome.Ok)
            {
                var notice = p.Notice;
                await p.LoadAsync();
                p.Notice = notice;
            }
        }
        finally { _busy = false; }
    }
}
