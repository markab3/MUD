@page "/creator/map"
@attribute [Authorize(Policy = WebPolicies.CreatorOrAdmin)]
@inject IAdminClient Core
@inject NavigationManager Navigation
@inject NoticeService Notices
<PageTitle>Room map - Planar Realms</PageTitle>
<h1>Room map</h1>
@if (_notice != null) { <p role="status" class="mud-ok">@_notice</p> }
@if (_presenter?.WireNotice != null) { <p role="status" class="mud-ok">@_presenter.WireNotice</p> }
@if (_presenter?.WireError != null) { <p role="alert" class="mud-error">@_presenter.WireError</p> }
@if (Created == 1 && !string.IsNullOrEmpty(Center))
{
    <p role="status" class="mud-ok" id="map-created">Created @Center.
        <a class="mud-link" href="@WebRoutes.RoomEdit(Center)">Edit room</a>
        @if (_presenter?.Map != null && _presenter.Map.Unplaced.Any(u => u.Key == Center))
        {
            <span> It has no X and Y, so it is not on the grid: find it in the Unplaced rooms list below.</span>
        }
    </p>
}
@if (_presenter == null)
{
    <p class="mud-loading" aria-busy="true">Loading...</p>
}
else if (_presenter.Error != null)
{
    <p role="alert" class="mud-error">@_presenter.Error</p>
    <div class="mud-actions"><button type="button" class="mud-btn" @onclick="ReloadAsync">Retry</button></div>
}
else if (_presenter.Areas.Count == 0)
{
    <p>There are no rooms.</p>
}
else
{
    var map = _presenter.Map!;
    <div class="mud-map-toolbar">
        <div class="mud-field"><label for="map-area">Area</label>
            <select id="map-area" value="@_presenter.Area" @onchange="OnAreaChanged">
                @foreach (var a in _presenter.Areas)
                {
                    <option value="@a" selected="@(a == _presenter.Area)">@_presenter.LabelFor(a)</option>
                }
            </select></div>
        <div class="mud-field"><label for="map-z">Level (Z)</label>
            <select id="map-z" value="@_presenter.Z" @onchange="OnLevelChanged">
                @if (_presenter.Levels.Count == 0)
                {
                    <option value="0" selected="selected">0</option>
                }
                @foreach (var l in _presenter.Levels)
                {
                    <option value="@l" selected="@(l == _presenter.Z)">@l</option>
                }
            </select></div>
    </div>
    <p>North is up. Drag to pan and pinch to zoom; tap a room to open it.
        A line between two rooms shows an arrowhead at the end of each exit that exists. Click an arrowhead to remove that exit (no confirmation, no undo);
        click a plain end to add the exit that leads to that room, from the other room. One exit changes per click. Dashed warning lines (direction mismatches)
        cannot be changed here.
        Around each room: a black arrow follows an exit that is not drawn as a line (to another level or area, off the map or to a missing room; remove those on the room's edit page),
        a gray arrow next to an existing room links to it (one direction only; click the plain end of its line to make it two-way),
        and a gray arrow with no room there opens Create room for that spot.
        The up and down arrows inside a room switch the map to another level.</p>
    @if (map.Rects.Count == 0)
    {
        <p>No placed rooms on this level.</p>
    }
    @if (map.ShowMap)
    {
        <RoomMap Map="map" FillFor="_presenter.FillFor" Center="@Center" OnAct="ApplyAsync" Busy="_busy" />
    }
    @if (map.Mismatches.Count > 0)
    {
        <section class="mud-section">
            <h2>Direction mismatches</h2>
            <p>The room coordinates disagree with the exit direction. Exits are the truth; these lines are dashed.</p>
            <ul class="mud-cardlist">
                @foreach (var m in map.Mismatches)
                {
                    <li>@m.FromKey @m.Direction → @m.ToKey</li>
                }
            </ul>
        </section>
    }
    <section class="mud-section">
        <h2>Unplaced rooms</h2>
        @if (map.Unplaced.Count == 0)
        {
            <p>None.</p>
        }
        else
        {
            <ul class="mud-cardlist">
                @foreach (var u in map.Unplaced)
                {
                    <li><a class="mud-link" href="@WebRoutes.RoomEdit(u.Key)">@u.Key</a> @u.Short</li>
                }
            </ul>
        }
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "area")] public string? Area { get; set; }
    [SupplyParameterFromQuery(Name = "z")] public int? Z { get; set; }
    // gx/gy: X,Y of the room a level arrow was clicked on (ghost square when this level has no room there).
    [SupplyParameterFromQuery(Name = "gx")] public int? Gx { get; set; }
    [SupplyParameterFromQuery(Name = "gy")] public int? Gy { get; set; }
    // center: room key to centre and outline; created=1: say "Created <key>" (set by Create room).
    [SupplyParameterFromQuery(Name = "center")] public string? Center { get; set; }
    [SupplyParameterFromQuery(Name = "created")] public int? Created { get; set; }

    private CreatorMapPresenter? _presenter;
    private string? _notice;
    private bool _busy;
    private string _token = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (_token.Length == 0)
        {
            _token = (await AuthState).User.FindFirstValue(SessionAuthentication.TokenClaim) ?? string.Empty;
            _notice = Notices.Take();
        }
        var presenter = new CreatorMapPresenter(Core, _token);
        var outcome = await presenter.LoadAsync(Area, Z, default, Gx, Gy);
        if (outcome == MapOutcome.Denied)
        {
            // The session ended or the role was lowered since the page was authorised (D31).
            Navigation.NavigateTo(WebRoutes.AccessDenied);
            return;
        }
        _presenter = presenter;
    }

    private Task ReloadAsync() => OnParametersSetAsync();

    // A click on a line end or a gray link arrow: one real write through the audited UpdateRoom (the page's CreatorOrAdmin policy applies,
    // as on the edit page). The map ignores clicks while it runs, and is then drawn again from core, whatever the answer.
    private async Task ApplyAsync(MapExitAction action)
    {
        if (_presenter == null || _busy) { return; }
        _busy = true;
        try
        {
            var write = new CreatorMapPresenter(Core, _token);
            await write.ApplyAsync(action);
            var presenter = new CreatorMapPresenter(Core, _token);
            var outcome = await presenter.LoadAsync(Area, Z, default, Gx, Gy);
            if (outcome == MapOutcome.Denied) { Navigation.NavigateTo(WebRoutes.AccessDenied); return; }
            presenter.CarryWire(write.WireNotice, write.WireError);
            _presenter = presenter;
        }
        finally { _busy = false; }
    }

    private void OnAreaChanged(ChangeEventArgs e) => Navigation.NavigateTo(WebRoutes.MapFor(e.Value?.ToString() ?? string.Empty, null));

    private void OnLevelChanged(ChangeEventArgs e) =>
        Navigation.NavigateTo(WebRoutes.MapFor(_presenter!.Area ?? string.Empty, int.TryParse(e.Value?.ToString(), out var z) ? z : 0));
}
