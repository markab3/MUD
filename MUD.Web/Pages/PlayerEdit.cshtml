@page "/creator/players/{nameKey}"
@model PlayerEditModel
@{ ViewData["Title"] = "Edit player"; }
<h1>Edit player</h1>
@if (Model.Missing)
{
    <p role="alert">@Model.Error</p>
    <p><a href="/creator/players">Back to the player list</a></p>
}
else
{
    <p>Player: <strong>@Model.Current?.Name</strong> (read-only). Current role: @(Model.Current == null ? "" : PlayerListModel.RoleText(Model.Current.Role))</p>
    @if (Model.Notice != null) { <p role="status">@Model.Notice</p> }
    @if (Model.Error != null) { <p role="alert">@Model.Error</p> }
    @if (!ViewData.ModelState.IsValid)
    {
        <div role="alert" asp-validation-summary="All"></div>
    }
    @if (!Model.CanEdit)
    {
        <p>You cannot edit this player: you may only edit players whose role is lower than yours.</p>
    }
    else
    {
        <form method="post" novalidate>
            @Html.AntiForgeryToken()
            <div><label>Short description <input asp-for="Short" maxlength="100" required /></label></div>
            <div><label>Long description <textarea asp-for="Long" maxlength="4000" rows="6"></textarea></label></div>
            <div><label>Race <input asp-for="Race" maxlength="32" /></label></div>
            <div><label>Gender <input asp-for="Gender" maxlength="32" /></label></div>
            <div><label>Class <input asp-for="Class" maxlength="32" /></label></div>
            @if (Model.CanSetRole)
            {
                <div>
                    <label>Role
                        <select asp-for="Role">
                            <option value="Player">Player</option>
                            <option value="Creator">Creator</option>
                        </select>
                    </label>
                    (Admin changes happen outside the website.)
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Role" />
            }
            @if (Model.CanSetRetired)
            {
                <div><label><input asp-for="Retired" type="checkbox" /> Retired (the character can no longer log in)</label></div>
            }
            else
            {
                <input type="hidden" asp-for="Retired" />
            }
            <button type="submit">Save player</button>
        </form>
    }
    <p><a href="/creator/players">Back to the player list</a></p>
}
