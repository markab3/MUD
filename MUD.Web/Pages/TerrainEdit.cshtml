@page "/creator/terrain/edit"
@model TerrainEditModel
@{ ViewData["Title"] = "Edit terrain library entry"; }
<h1>@(Model.IsNew ? "New" : "Edit") @TerrainLibrary.KindLabel(Model.Kind ?? "").ToLowerInvariant()</h1>
<p><a href="/creator/terrain">Back to the library</a></p>
@if (Model.Missing)
{
    <p role="alert">@Model.Error</p>
}
else
{
    @if (Model.Notice != null) { <p role="status">@Model.Notice</p> }
    @if (Model.Error != null) { <p role="alert">@Model.Error</p> }
    @if (!ViewData.ModelState.IsValid)
    {
        <div role="alert" asp-validation-summary="All"></div>
    }
    @if (Model.Unused)
    {
        <p role="note"><strong>[!] @TerrainLibrary.UnusedWarning.</strong> With no terrain ticked, no generator will ever pick this entry. It is not "any terrain".</p>
    }
    <form method="post" asp-page-handler="Save" asp-route-kind="@Model.Kind" asp-route-id="@(Model.IsNew ? null : Model.Id)" novalidate>
        @Html.AntiForgeryToken()
        <div><label>Id <input asp-for="Id" maxlength="100" readonly="@(!Model.IsNew)" required /></label>
            (letters, digits, '-', '_' and '.'; fixed once created)</div>
        <fieldset>
            <legend>Terrains (empty = not used by any generator)</legend>
            @foreach (var t in Model.TerrainChoices)
            {
                <label><input type="checkbox" name="Terrains" value="@t" checked="@Model.Terrains.Contains(t)" /> @t</label>
            }
            <div><label>Other terrain ids (comma or space separated) <input asp-for="ExtraTerrains" maxlength="400" /></label></div>
        </fieldset>
        @if (Model.Kind == TerrainLibrary.Fragment)
        {
            <div><label>Slot <input asp-for="Slot" maxlength="100" required /></label></div>
            <div><label>Text <textarea asp-for="Text" maxlength="2000" rows="4" required></textarea></label></div>
            <div><label>Weight <input asp-for="Weight" type="number" min="0" /></label></div>
            <div><label>Tags <input asp-for="Tags" /></label> (comma or space separated)</div>
        }
        else if (Model.Kind == TerrainLibrary.Feature)
        {
            <p>Version: @Model.Version. @Model.VersionHint</p>
            <div><label>Short <input asp-for="Short" maxlength="100" required /></label></div>
            <div><label>Long <textarea asp-for="Long" maxlength="2000" rows="4" required></textarea></label></div>
            <div><label>Room line <input asp-for="RoomLine" maxlength="2000" /></label> (optional)</div>
            <div><label>Detail <textarea asp-for="Detail" maxlength="2000" rows="3"></textarea></label> (optional)</div>
            <div><label>Handles <input asp-for="Handles" /></label> (comma or space separated)</div>
            <div><label>Adjectives <input asp-for="Adjectives" /></label> (comma or space separated)</div>
            <div><label>Weight <input asp-for="Weight" type="number" min="0" /></label></div>
            <div><label>Chance <input asp-for="Chance" type="number" step="0.01" min="0" max="1" /></label> (0 to 1)</div>
            <div><label>Tags <input asp-for="Tags" /></label> (comma or space separated)</div>
        }
        else
        {
            <div><label>Neighbour terrain <input asp-for="NeighborTerrain" maxlength="100" required list="terrain-list" /></label></div>
            <datalist id="terrain-list">
                @foreach (var t in Model.TerrainChoices) { <option value="@t"></option> }
            </datalist>
            <div><label>Text <input asp-for="Text" maxlength="2000" required /></label> (must contain <code>{dir}</code> exactly once)</div>
            <div><label>Weight <input asp-for="Weight" type="number" min="0" /></label></div>
            <div><label><input asp-for="Merge" type="checkbox" /> Merge several sides into one phrase ("north and east")</label></div>
        }
        <div><button type="submit">Save</button></div>
    </form>
    @if (Model.Kind == TerrainLibrary.Phrase || Model.Kind == TerrainLibrary.Feature)
    {
        <h2>Preview</h2>
        @if (Model.Kind == TerrainLibrary.Phrase) { <p>@TerrainLibrary.PhrasePreview(Model.Text)</p> }
        else { <p>@(string.IsNullOrWhiteSpace(Model.RoomLine) ? Model.Short : Model.RoomLine)</p> }
        <p><small>Preview of the saved values. Core offers no sample-room render yet.</small></p>
    }
}
