@page "/account/password"
@model PasswordModel
@{ ViewData["Title"] = "Change password"; }
<h1>Change password</h1>
@if (Model.Succeeded)
{
    <p role="status">Your password has been changed.</p>
}
@if (Model.Error != null)
{
    <p role="alert">@Model.Error</p>
}
<form method="post">
    @Html.AntiForgeryToken()
    <div><label>Current password <input name="Current" type="password" autocomplete="current-password" required /></label></div>
    <div><label>New password <input name="New" type="password" autocomplete="new-password" maxlength="64" required /></label></div>
    <div><label>Confirm new password <input name="Confirm" type="password" autocomplete="new-password" maxlength="64" required /></label></div>
    <button type="submit">Change password</button>
</form>
