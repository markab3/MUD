@page "/creator/terrain"
@model TerrainListModel
@{ ViewData["Title"] = "Terrain library"; }
<h1>Terrain library</h1>
@if (Model.Notice != null) { <p role="status">@Model.Notice</p> }
@if (Model.Error != null) { <p role="alert">@Model.Error</p> }
<nav aria-label="Library tabs">
    <a href="/creator/terrain?tab=fragment">Fragments (@Model.Fragments.Count)</a> |
    <a href="/creator/terrain?tab=feature">Features (@Model.Features.Count)</a> |
    <a href="/creator/terrain?tab=phrase">Neighbour phrases (@Model.Phrases.Count)</a> |
    <a href="/creator/terrain?tab=unassigned">Unassigned (@Model.UnassignedCount)</a>
</nav>
<p>Showing: <strong>@Model.TabLabel</strong>.
    <a href="/creator/terrain/edit?kind=fragment">New fragment</a> |
    <a href="/creator/terrain/edit?kind=feature">New feature template</a> |
    <a href="/creator/terrain/edit?kind=phrase">New neighbour phrase</a></p>
@if (Model.Tab == TerrainLibrary.Unassigned)
{
    <p role="note"><strong>[!] @TerrainLibrary.UnusedWarning.</strong> These entities have no terrain, so no generator will ever pick them. Edit one and tick a terrain to enable it.</p>
}
<form method="get">
    <input type="hidden" name="tab" value="@Model.Tab" />
    <label>Terrain <input name="terrain" value="@Model.TerrainFilter" maxlength="100" list="terrain-list" /></label>
    <label>Tag <input name="tag" value="@Model.TagFilter" maxlength="100" /></label>
    <button type="submit">Filter</button>
    <datalist id="terrain-list">
        @foreach (var t in Model.KnownTerrains) { <option value="@t"></option> }
    </datalist>
</form>
<table>
    <thead><tr><th>Kind</th><th>Id</th><th>Terrains</th><th>Weight</th><th>Details</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var r in Model.Rows)
    {
        <tr>
            <td>@TerrainLibrary.KindLabel(r.Kind)</td>
            <td>@r.Id</td>
            <td>
                @if (r.Terrains.Count == 0) { <strong>[!] @TerrainLibrary.UnusedWarning</strong> }
                else { @string.Join(", ", r.Terrains) }
            </td>
            <td>@r.Weight</td>
            <td>@r.Details</td>
            <td>
                <a href="@TerrainListModel.EditUrl(r.Kind, r.Id)">Edit</a>
                <form method="post" asp-page-handler="Delete" style="display:inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="kind" value="@r.Kind" />
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="tab" value="@Model.Tab" />
                    <button type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Rows.Count == 0)
    {
        <tr><td colspan="6">Nothing here.</td></tr>
    }
    </tbody>
</table>
