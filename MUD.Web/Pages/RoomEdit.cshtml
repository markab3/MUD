@page "/creator/rooms/{key}"
@model RoomEditModel
@{ ViewData["Title"] = "Edit room"; }
<h1>Edit room</h1>
@if (Model.Missing)
{
    <p role="alert">@Model.Error</p>
    <p><a href="/creator/map">Back to the map</a></p>
}
else
{
    <p>Room key: <code>@Model.Key</code> (read-only)</p>
    @if (Model.Notice != null) { <p role="status">@Model.Notice</p> }
    @if (Model.Error != null) { <p role="alert">@Model.Error</p> }
    @if (!ViewData.ModelState.IsValid)
    {
        <div role="alert" asp-validation-summary="All"></div>
    }
    <form method="post" novalidate>
        @Html.AntiForgeryToken()
        <div><label>Short description <input asp-for="Short" maxlength="100" required /></label></div>
        <div><label>Long description <textarea asp-for="Long" maxlength="4000" rows="8" required></textarea></label></div>
        <div><label>Area prefix <input asp-for="Area" maxlength="128" readonly /></label> (fixed by the room key; rooms cannot be renamed)</div>
        <div>
            <label>X <input asp-for="X" type="number" /></label>
            <label>Y <input asp-for="Y" type="number" /></label>
            <label>Z <input asp-for="Z" type="number" /></label>
            (leave a field blank for an unplaced room; blank is not 0)
        </div>
        <fieldset>
            <legend>Exits (direction and target room key)</legend>
            @for (var i = 0; i < Model.Exits.Count; i++)
            {
                <div>
                    <input asp-for="Exits[i].Dir" maxlength="32" placeholder="north" aria-label="Exit direction" />
                    <input asp-for="Exits[i].To" maxlength="128" placeholder="area.room" aria-label="Exit target room key" />
                    <button type="submit" formaction="@(RoomEditModel.RoomUrl(Model.Key))?handler=RemoveExit&amp;index=@i" formnovalidate>Remove</button>
                </div>
            }
            <div><button type="submit" formaction="@(RoomEditModel.RoomUrl(Model.Key))?handler=AddExit" formnovalidate>Add exit</button></div>
            <div><label><input asp-for="ConfirmDangling" type="checkbox" /> Save exits to rooms that do not exist</label></div>
        </fieldset>
        <fieldset>
            <legend>Features (things in the room that players can look at)</legend>
            <p><small>Handles, adjectives and plurals: separate words with commas or spaces, for example <code>fountain, basin</code>.
            A feature keeps any behavior or component set up with the in-game creator commands while its short description stays the same;
            renaming or removing a feature drops that behavior. The order here is the stored order.</small></p>
            @for (var i = 0; i < Model.Features.Count; i++)
            {
                <fieldset>
                    <legend>Feature @(i + 1)</legend>
                    <div><label>Short <input asp-for="Features[i].Short" maxlength="100" /></label></div>
                    <div><label>Long <textarea asp-for="Features[i].Long" maxlength="4000" rows="4"></textarea></label></div>
                    <div><label>Room line <input asp-for="Features[i].RoomLine" maxlength="4000" /></label> (optional)</div>
                    <div><label>Detail <textarea asp-for="Features[i].Detail" maxlength="4000" rows="3"></textarea></label> (optional)</div>
                    <div><label>Handles <input asp-for="Features[i].Handles" /></label> (comma or space separated)</div>
                    <div><label>Adjectives <input asp-for="Features[i].Adjectives" /></label> (comma or space separated)</div>
                    <div><label>Plurals <input asp-for="Features[i].Plurals" /></label> (comma or space separated)</div>
                    <div>
                        <button type="submit" formaction="@(RoomEditModel.RoomUrl(Model.Key))?handler=MoveFeatureUp&amp;index=@i" formnovalidate>Move up</button>
                        <button type="submit" formaction="@(RoomEditModel.RoomUrl(Model.Key))?handler=MoveFeatureDown&amp;index=@i" formnovalidate>Move down</button>
                        <button type="submit" formaction="@(RoomEditModel.RoomUrl(Model.Key))?handler=RemoveFeature&amp;index=@i" formnovalidate>Remove</button>
                    </div>
                </fieldset>
            }
            <div><button type="submit" formaction="@(RoomEditModel.RoomUrl(Model.Key))?handler=AddFeature" formnovalidate>Add feature</button></div>
        </fieldset>
        <button type="submit" formaction="@(RoomEditModel.RoomUrl(Model.Key))?handler=Save">Save room</button>
    </form>

    <form method="post" action="@(RoomEditModel.RoomUrl(Model.Key))?handler=Move">
        @Html.AntiForgeryToken()
        <fieldset>
            <legend>Move room (change its key)</legend>
            <div>
                <label>Area prefix <input asp-for="NewArea" maxlength="128" list="area-list" autocomplete="off" required /></label>
                <label>Local key <input asp-for="NewLocalKey" maxlength="64" required /></label>
                <button type="submit">Move room</button>
            </div>
            <datalist id="area-list">
                @foreach (var a in await Model.GetAreasAsync()) { <option value="@a"></option> }
            </datalist>
            <small>The new key is <code>area prefix.local key</code>. Exits that lead here, players standing here, and everything inside follow the room. The default room cannot be moved.</small>
        </fieldset>
    </form>

    <form method="post" action="@(RoomEditModel.RoomUrl(Model.Key))?handler=Delete">
        @Html.AntiForgeryToken()
        <button type="submit">Delete this room</button>
        <small>Everything inside is moved to a neighbouring room, or to the default room. The default room cannot be deleted.</small>
    </form>
    <p><a href="/creator/map">Back to the map</a></p>
}
